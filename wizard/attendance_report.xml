<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="attendance_report_form" model="ir.ui.view">
        <field name="name">Attendance Report</field>
        <field name="model">sd_contacts.attendance_report_wizard</field>
        <field name="arch" type="xml">
            <form create="0">
                <group>
                    <group>
                        <field name="gate"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                </group>
                <footer>
                        <button name="attendance_report" string="Attendance report" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
            </form>
        </field>
    </record>

    <record id="attendance_report_action" model="ir.actions.act_window">
        <field name="name">Attendance Report</field>
        <field name="res_model">sd_contacts.attendance_report_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem name="Attendances"
              id="attendances_reports_menu"
              parent="reports_menu"
              groups="sd_contacts.group_sd_contacts_users"
              action="attendance_report_action"
    />


</odoo>
