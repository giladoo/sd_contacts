<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="attendance_list_a4" model="report.paperformat">
    <field name="name">Contract Daily A4 Landscape</field>
    <field name="default" eval="True"/>
    <field name="format">custom</field>
    <field name="page_height">297</field>
    <field name="page_width">210</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">20</field>
    <field name="margin_bottom">7</field>
    <field name="margin_left">5</field>
    <field name="margin_right">5</field>
    <field name="header_line" eval="True"/>
    <field name="header_spacing">20</field>
    <field name="dpi">100</field>
</record>

    <record id="attendance_list_report" model="ir.actions.report">
        <field name="name">Attendance List</field>
        <field name="model">hr.attendance</field>
<!--        <field name="report_type">xlsx</field>-->
        <field name="report_type">qweb-html</field>
<!--        <field name="report_type">qweb-pdf</field>-->
        <field name="report_name">sd_contacts.attendance_list_template</field>
        <field name="report_file">sd_contacts.attendance_list_template</field>
        <field name="print_report_name">'attendance-%s' % object.name </field>
        <field name="paperformat_id" ref="attendance_list_a4"/>
<!--        <field name="binding_model_id" ref="model_hr_attendance"/>-->
<!--        <field name="binding_type">report</field>-->
    </record>


</odoo>
