<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="attendance_list_report_template">
            attendance_list_report_template
        </template>

        <template id="attendance_list_template">
            <t t-call="web.basic_layout" t-lang="lang"  >
                <div style="font-family: IRANSansFN;">
                <div class="" >
                    Attendance
                </div>
                <div class="row row-cols-auto my-3 p-2 border rounded rounded-3">
                    <div class="col-4">Location:
                        <span class=" mx-2" t-esc="location[1] if location else 'All Locations'"></span>

                    </div>
                    <div class="col-8">Gates:
                        <t t-if="not len(gates)">
                            <span class="col mx-2">All Gates</span>
                        </t>
                        <t t-foreach="gates"  t-as="gate" t-key="gate.id">
                            <span class=" mx-2" t-esc="gate.name"></span>
                        </t>

                    </div>

<!--                    <div class="col-3" t-esc="data['start_date']"></div>-->
<!--                    <div class="col-3" t-esc="data['end_date']"></div>-->

                </div>
                <t t-foreach="grouped" t-as="name" t-key="name">
                    <div class="row border">
                        <div class="col-4 px-2" t-esc="name"></div>
<!--                        <div class="col-2" t-esc="grouped"></div>-->
                        <div class="col-8">
                            <t t-foreach="grouped[name]" t-as="attendance_list" t-key="attendance_list">
                                <div class="row">
                                    <div class="col-4" t-esc="attendance_list['check_in']"></div>
                                    <div class="col-4" t-esc="attendance_list['check_out']"></div>

                                </div>
                            </t>

                        </div>
                    </div>
                </t>


<!--                <t t-foreach="attendances" t-as="attendance" t-key="attendance.id">-->
<!--                    <div class="row border">-->
<!--                        <div class="col-2" t-esc="attendance['name']"></div>-->
<!--                        <div class="col-2">-->
<!--                            <div class="" t-esc="attendance['check_in']"></div>-->

<!--                        </div>-->
<!--                        <div class="col-2" t-esc="attendance['check_out']"></div>-->
<!--                    </div>-->
<!--                </t>-->
                </div>
            </t>
<!--            <t t-foreach="docs" t-as="o">-->
<!--                <t t-call="web.basic_layout" t-lang="lang">-->
<!--                        <t t-set="lang" t-value="o.env.context.get('lang')"/>-->
<!--                        <t t-call="sd_contacts.attendance_list_report_template" t-lang="lang"/>-->
<!--                </t>-->
<!--            </t>-->
        </template>

    </data>
</odoo>
