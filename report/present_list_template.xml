<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="present_list_report_template">
            present_list_report_template
        </template>

        <template id="present_list_template">
            <t t-call="web.basic_layout" t-lang="lang">
                <div class="border rounded mb-1 p-3" style="font-family: IRANSansFN;">
                    <div class="row">
                        <div class="col">
                            <div class="row row-cols-auto ">
                                <div class="mx-1 me-3">Locations List</div>
                                <t t-foreach="locations" t-as="location" t-key="location">
                                    <div class="mx-1 h3" t-esc="location"></div>
                                </t>
                            </div>
                        </div>
                        <div class="col">
                            <div class="row row-cols-auto">
                                <div class=" h6 me-3" t-esc="'Present employees:'"></div>
                                <div class=" h3" t-esc="str(count)"></div>
                            </div>
                        </div>
                        <div class="col">
                            <div class=" h3" t-esc="date_now_s"></div>
                        </div>
                    </div>
                </div>
                <t t-set="list_1" t-value="[1,2,3,4,5,6,7,8,9]"></t>
                <t t-set="col_counts" t-value="4"/>
                <t t-set="row_counts" t-value="len(att_employees)//col_counts + 1"/>
                <t t-set="row_counter" t-value="0"/>
                <t t-set="index" t-value="0"/>
                <div class="">
                    <t t-foreach="grouped_att" t-as="work_place" t-key="work_place">
                        <div t-if="work_place" class="h1 bg-500 mt-5 py-3 text-center rounded" t-esc="work_place"></div>
                        <div t-else="" class="h1 bg-500 mt-5 py-3 text-center rounded" t-esc="''"></div>
                        <table class="table text-center" style="font-family: IRANSansFN;">
                            <tbody>
                                <tr t-foreach="row_counts" t-as="row_count">
                                    <t t-foreach="grouped_att[work_place][row_count*col_counts:row_count*col_counts + col_counts]"
                                       t-as="att" t-key="l">
                                        <td class="" style="width: 20%;">
                                            <div onClick="onClick(att.employee_id.id)" id="att.employee_id.id" class="emp_image">
                                                <img t-att-src="'/web/image?model=hr.employee.public&amp;id=' + str(att.employee_id.id) + '&amp;field=avatar_128'"
                                                     style="width: 120px;height: 120px;"
                                                />
                                            </div>
                                            <div class="h3 mt-2" t-esc="att.employee_id.name"></div>
                                            <div class="" t-esc="att.employee_id.department_id.name"></div>
                                            <div class="" t-esc="att.employee_id.mobile_phone"></div>
                                        </td>
                                    </t>
                                    <t t-set="index" t-value="index+col_counts"/>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <div  class="h1 bg-500 mt-5 py-3 text-center rounded" t-esc="'Visitors'"></div>
                <t t-set="col_counts" t-value="4"/>
                <t t-set="row_counts" t-value="len(att_visitors)//col_counts + 1"/>
                <t t-set="row_counter" t-value="0"/>
                <t t-set="index" t-value="0"/>
<!--                    <t t-foreach="att_visitors" t-as="visit" t-key="visit.id">-->
                        <table class="table text-center" style="font-family: IRANSansFN;">
                            <tbody>
                                <tr t-foreach="row_counts" t-as="row_count">
                                    <t t-foreach="att_visitors[row_count*col_counts:row_count*col_counts + col_counts]"
                                       t-as="att" t-key="l">
                                        <td class="" style="width: 20%;">
<!--                                            <div onClick="onClick(att.employee_id.id)" id="att.employee_id.id" class="emp_image">-->
<!--                                                <img t-att-src="'/web/image?model=hr.employee.public&amp;id=' + str(att.employee_id.id) + '&amp;field=avatar_128'"-->
<!--                                                     style="width: 120px;height: 120px;"-->
<!--                                                />-->
<!--                                            </div>-->
                                            <div class="h3 mt-2" t-esc="att.name.name"></div>
                                            <div class="" t-esc="att.name.mobile_no"></div>
                                            <div class="" t-esc="att.employee_id.name"></div>
                                        </td>
                                    </t>
                                    <t t-set="index" t-value="index+col_counts"/>
                                </tr>
                            </tbody>
                        </table>

<!--                    </t>-->
                </div>
            </t>
        </template>
    </data>
</odoo>
