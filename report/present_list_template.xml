                                        <div>
                                            <img t-att-src="'/web/image?model=hr.employee.public&amp;id=' + str(att.employee_id.id) + '&amp;field=avatar_128'"
                                            style="width: 100px;height: 100px;"
                                            />
                                        </div>
                                        <div class="" t-esc="att.employee_id.name"></div>
                                        <div class="" t-esc="att.employee_id.department_id.name"></div>
                                        <div class="" t-esc="att.employee_id.mobile_phone"></div>

                                    </td>

                                 </t>
                                <t t-set="index" t-value="index+col_counts"/>
                            </tr>
                    </tbody>
                </table>
