                        </t>
                    </div>
                </div>
                <t t-set="list_1" t-value="[1,2,3,4,5,6,7,8,9]"></t>
                <t t-set="col_counts" t-value="5"/>
                <t t-set="row_counts" t-value="len(att_employees)//col_counts + 1"/>
                <t t-set="row_counter" t-value="0"/>
                <t t-set="index" t-value="0"/>
<!--                <div class="" t-esc="'row_counts: ' + str(row_counts)"></div>-->

                <table class="table text-center"  style="font-family: IRANSansFN;">
                    <tbody>
                            <tr t-foreach="row_counts" t-as="row_count">

                                <t t-foreach="att_employees[row_count*col_counts:row_count*col_counts + col_counts]" t-as="att" t-key="l">
<!--                                    <div class="" t-esc="'[row_count: ' + str(row_count) + ' ] {index: ' + str(index) + '}'"></div>-->
