<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="location_list" model="ir.ui.view">
        <field name="name">Location</field>
        <field name="model">hr.work.location</field>
        <field name="priority">900</field>
        <field name="arch" type="xml">
                <list create="0" delete="0" editable="bottom">
                    <field name="name"/>
                    <field name="emergency_emails" widget="many2many_avatar_employee"/>
                </list>
            </field>
    </record>

    <record id="location_action" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">hr.work.location</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="location_list"/>

    </record>

    <menuitem name="Locations"
              id="location_menu"
              parent="configuration_menu"
              groups="sd_contacts.group_sd_contacts_admins"
              action="location_action" />

</odoo>