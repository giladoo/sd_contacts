<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!--__________________________________ Visitors ____________________________________-->

    <record id="visitors_list" model="ir.ui.view">
        <field name="name">Visitors</field>
        <field name="model">sd_contacts.visitors</field>
        <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="national_id"/>
                    <field name="mobile_no"/>
                </list>
            </field>
    </record>
    <record id="visitors_form" model="ir.ui.view">
        <field name="name">Visitors</field>
        <field name="model">sd_contacts.visitors</field>
        <field name="arch" type="xml">
                <form >
                    <sheet>
                        <group>
                            <group>
                                <field name="name" class="h3"/>
                                <field name="national_id"/>
                                <field name="mobile_no"/>

                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
    </record>

    <record id="visitors_action" model="ir.actions.act_window">
        <field name="name">Visitorss</field>
        <field name="res_model">sd_contacts.visitors</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="visitors_list"/>

    </record>

    <!--__________________________________ Visits ____________________________________-->

    <record id="visits_form" model="ir.ui.view">
        <field name="name">Visits</field>
        <field name="model">sd_contacts.visits</field>
        <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" placeholder="Visitor's name"
                                       options="{'no_open': True, 'no_quick_create': True}"/>
                                <field name="employee_id" string="Visited" placeholder="whom to visit to"
                                options="{'no_open': True, 'no_create_edit': True, 'no_quick_create': True}"/>
<!--                                <field name="check_out" readonly="0"/>-->
                                <!--                                <field name="out_gate" readonly="0"/>-->
                            </group>
                            <group>
                                <field name="check_in" readonly="1"/>
                                <field name="in_gate" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="e.g. Meeting"/>
                        </group>
                    </sheet>
                </form>
            </field>
    </record>

    <record id="visits_list" model="ir.ui.view">
        <field name="name">Visits</field>
        <field name="model">sd_contacts.visits</field>
        <field name="arch" type="xml">
                <list create="1" delete="1" default_order=" check_in desc, name">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="check_in"/>
                    <field name="in_gate"/>
                    <field name="check_out"/>
                    <field name="out_gate"/>
                </list>
            </field>
    </record>

    <record id="visits_search" model="ir.ui.view">
        <field name="name">Visits</field>
        <field name="model">sd_contacts.visits</field>
        <field name="arch" type="xml">
                <search >
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="check_in"/>
                    <field name="check_out"/>
                    <filter string="Today" name="today"
                        domain="[('check_in', '&gt;=', datetime.datetime.combine(context_today(),
                        datetime.time(0,0,0))), ('check_in', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                    <filter name="name_group" string="Visitor" context="{'group_by': 'name'}" />
                    <filter name="check_in_group" string="Check In" default_period="year"
                            context="{'group_by': 'check_in'}" />
                </search>
            </field>
    </record>

    <record id="visits_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">sd_contacts.visits</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="visits_list"/>
        <field name="context">{'search_default_today': 1}</field>

    </record>

    <!--__________________________________ Menu ____________________________________-->

    <menuitem name="Visitors"
              id="visitors_menu"
              parent="configuration_menu"
              groups="sd_contacts.group_sd_contacts_admins"
              action="visitors_action" />

    <menuitem name="Visits"
              id="visits_menu"
              parent="configuration_menu"
              groups="sd_contacts.group_sd_contacts_admins"
              action="visits_action" />


</odoo>