<?xml version="1.0" encoding="UTF-8" ?>
<template xml:space="preserve">
    <t t-name="sd_contacts.security_gates_template" owl="1">
        <div class="vh-100 px-5  bg-muted">
            <div class="border rounded my-2 shadow" t-ref="last_attendance_list_view" style="min-height: 100px;">
                latest Attendances
            </div>
            <div class="row">
                <div class="col-12 col-md-6">
                    <div class="col-12 border rounded shadow " style="min-height: 100px;">
                        <div class="" t-ref="employee_attendance_data"></div>

                    </div>
                    <div class="mt-3 border rounded shadow" style="height: 400px;">
                        <SdContactsDashboard t-on-click="onEmployeeListClick" sendUpdates="this.state.sendUpdates"/>

                    </div>
                </div>

            </div>
        </div>
    </t>



    <t t-name="sd_contacts.attendance_template" owl="1">
        <div class="row mx-0 p-3 shadow">
            <div class="col-3 text-center align-content-start">
                <div class="h-75 ">
                    <div class="px-1 py-1">
                        <div class="img_div rounded-circle border  p-1 ${statusBorder} employee_image_id mx-auto" t-att-id="props.data.employee.id"
                             t-att-style="'background-image: url(/web/image?model=hr.employee.public&amp;id='+ props.data.employee.id +'&amp;field=avatar_128)'"></div>
                    </div>
                        <div class="" t-esc="props.data.employee.name"></div>

                </div>
                <div class="btn btn-primary mt-2" t-on-click="() => this.onInOutClick(props.data.employee.id)">
                    In/Out
                </div>
            </div>
            <div class="col-3">
                <t t-foreach="props.data.attendances" t-as="attendance" t-key="attendance.id">
                    <div class="row text-center ">
                        <div class="col-6 bg-success-light border-bottom rounded-start" t-esc="attendance.check_in"></div>
                        <div t-if="attendance.check_out" class="col-6 bg-danger-light border-bottom rounded-end" t-esc="attendance.check_out"></div>

                    </div>
                </t>
            </div>
            <div class="col-6  text-center align-content-start">
                <div class="h-100 ">
                    <div class="h5  my-0 py-1 bg-300 rounded">Requests</div>
                    <t t-foreach="props.data.leaves" t-as="leave" t-key="leave">
                        <div t-att-class="'row mx-0 border-bottom ' + (leave.state_icon == 'fa-check' ? 'text-success' : '')">
                            <div class="col-1 p-1  " ><i t-att-class="'fa ' + leave.state_icon"></i></div>
                            <div class="col-7 p-1  " t-esc="leave.leave_type"></div>
                            <div class="col-2 p-1 " t-esc="leave.start"></div>
                            <div class="col-2 p-1 " t-esc="leave.end"></div>
                        </div>

                    </t>
                </div>

            </div>

        </div>
    </t>

    <t t-name="sd_contacts.last_attendance_template" owl="1">
        <div class="row row-cols-auto justify-content-center  mx-0 p-2 ">
            <div class="col me-5 align-content-around">
                <div class="h3 text-center" t-esc="props.today"></div>
                <div class="row mb-3 p-1 rounded bg-success-light cursor-pointer" t-on-click="() => this.onCounterClick('presents')">
                    <div class="col-6">
                        Presents
                    </div>
                    <div class="col-6" t-esc="props.presents"></div>
                </div>
                <div class="row mb-3 p-1  rounded bg-danger-light">
                    <div class="col-6">
                        Absence
                    </div>
                    <div class="col-6" t-esc="props.absence"></div>
                </div>
                <div class="row p-1  rounded bg-dark-light">
                    <div class="col-6">
                        All
                    </div>
                    <div class="col-6" t-esc="props.presents + props.absence"></div>
                </div>
            </div>
            <div t-foreach="props.lastAttendances" t-as="last_att" t-key="last_att.id" class="col text-center" t-on-click="">
                <div class="col align-content-around">
                    <div class="px-1 py-1">
                        <div class="img_div rounded-circle border  p-1 ${statusBorder} mx-auto employee_image_id" t-att-id="last_att.employee_id[0]" t-on-click="this.onEmployeeListClick"
                             t-att-style="'background-image: url(/web/image?model=hr.employee.public&amp;id='+ last_att.employee_id[0] +'&amp;field=avatar_128)'"></div>
                    </div>
                    <div class="" t-esc="last_att.employee_id[1]"></div>
                    <div t-if="last_att.dir == 'in'" class="bg-success-light rounded" >
                        <div class="" t-esc="last_att.time[0]"></div>
                        <div class="" t-esc="last_att.time[1]"></div>
                    </div>
                    <div t-if="last_att.dir == 'out'" class="bg-danger-light rounded">
                        <div class="" t-esc="last_att.time[0]"></div>
                        <div class="" t-esc="last_att.time[1]"></div>
                    </div>
                </div>

            </div>

        </div>
    </t>


</template>
