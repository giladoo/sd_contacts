<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sd_contacts.contact_list_template">
        <div class="vh-1001 overflow-auto1 bg-muted">
            <div class="container h-100 my-4 px-1 ">
                <div t-if="this.state.send_list.length" class=" mb-2 text-end">
                    <t t-foreach="this.state.send_list" t-as="send" t-key="send.id">
                        <div class="btn btn-danger" t-esc="send.location[1]" t-on-click="()=>onSendListClick(send.location[0])"></div>

                    </t>
                </div>
                <div class="row  mx-0 ">
                    <div class="col mx-0">
                        <div class="h3 text-center mt-2 mb-4" t-esc="this.state.labels.title"></div>
                        <div class="row mx-0">
                            <div class="col-12 col-md-4">
                                <div class="row">
                                    <div class="col-1 btn  border-0 px-2"
                                         t-ref="refresh_list" t-on-click="() => this.refreshList()">
                                        <i class=" fa fa-refresh text-600"></i>
                                    </div>
                                    <div class="col-1 btn  border-0 btn-close px-2"
                                         t-ref="search_clear" t-on-click="() => this.selectFilterItems(true)">
                                    </div>
                                    <div class="col-9">
                                        <input type="text" t-ref="contacts_search"
                                               class="contacts_search form-control shadow-lg border border-primary-subtle"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-md-2 p-1 text-center d-none1 d-md-block"
                                 t-ref="contacts_select_department">
                                <Dropdown>
                                    <button class="btn btn-outline-primary" type="button" t-ref="selected_department"/>
                                    <t t-foreach="this.state.departments" t-as="layout" t-key="layout" t-set-slot="content">
                                        <DropdownItem onSelected="() => this.selectDepartment(layout)">
                                            <t t-esc="layout"></t>
                                        </DropdownItem>
                                    </t>
                                </Dropdown>
                            </div>
                            <div  t-if="this.state.show.show_locations" class="col-6 col-md-2 p-1 text-center d-none1 d-md-block"
                                  t-ref="contacts_select_location">
                                <Dropdown>
                                    <button class="btn btn-outline-primary" type="button" t-ref="selected_location"/>
                                    <t t-foreach="this.state.locations" t-as="layout" t-key="layout" t-set-slot="content">
                                        <DropdownItem onSelected="() => this.selectLocation(layout)">
                                            <t t-esc="layout"></t>
                                        </DropdownItem>
                                    </t>
                                </Dropdown>
                            </div>
                            <div t-if="this.state.show.show_projects" class="col-6 col-md-2 p-1 text-center d-none1 d-md-block"
                                 t-ref="contacts_select_project">
                                <Dropdown>
                                    <button class="btn btn-outline-primary" type="button" t-ref="selected_project"/>
                                    <t t-foreach="this.state.projects" t-as="layout" t-key="layout" t-set-slot="content">
                                        <DropdownItem onSelected="() => this.selectProject(layout)">
                                            <t t-esc="layout"></t>
                                        </DropdownItem>
                                    </t>
                                </Dropdown>
                            </div>
                        </div>

                    </div>


                </div>
                <div t-ref="contacts_companies"
                     class="contacts_companies d-none bg-white text-center rounded-top  shadow-lg mt-2 mx-4 p-1 p-md-3 "></div>
                <div class="mt-4 shadow-lg">
                    <div class="row row-cols-auto col-12 contacts_list_header bg-primary rounded-top shadow-sm mx-0 py-1">
                        <div class="col-2 col-md-1 p-1 text-center"> </div>
                        <div class="col-10 col-md-11 mx-0 px-0">
                            <div class="row py-3 p-md-0 mx-0">
                                <t t-set="locproj" t-value="this.state.show.show_locations or this.state.show.show_projects"/>

                                <t  t-set="jobdepcol"  t-value="'col-8'"/>
                                <t t-if="locproj" t-set="jobdepcol" t-value="'col-6'"/>

                                <t t-set="locprojcol"  t-value="'col-4'"/>
                                <t t-if="locproj" t-set="locprojcol"  t-value="'col-6'"/>

                                <div t-att-class="jobdepcol + ' row row-cols-auto  mx-0 mb-1 px-0'">
                                    <div class="row1 row-cols-auto1 align-content-around col-12 col-md-6 p-1 text-center down sortable sort_employee_name cursor-pointer">
                                        <div class=" " t-esc="this.state.labels.name"></div>
                                        <div t-att-class="'px-0 fa fa-chevron-' + this.state.dir.name"></div>
                                    </div>
                                    <div t-ref="contacts_select_department1"
                                         class="row row-cols-auto col-12 col-md-6 p-1 text-center d-none1 d-md-block sortable sort_department">
                                        <div class=" " t-esc="this.state.labels.depjob"></div>
                                        <div t-att-class="'px-0 fa fa-chevron-' + this.state.dir.department"></div>
                                    </div>
                                    <div class="col-2"></div>
                                </div>
                                <div  t-att-class="locprojcol + '  row row-cols-auto mx-0 mb-1 px-0'">
                                    <div   t-if="locproj"  class="col-12  -danger col-md-3 p-1 text-center d-none d-md-block">
                                        <div t-out="this.state.labels.location_project"></div>
                                    </div>

                                    <div class="row row-cols-auto mx-0 col-12 col-md-3 p-1 text-center d-none1 d-md-block sortable sort_phone">
                                        <div class=" " t-esc="this.state.labels.phone"></div>
                                        <div t-att-class="'px-0 fa fa-chevron-' + this.state.dir.phone"></div>
                                    </div>
                                    <div class="col-12 col-md-6 p-1 text-center d-none1 d-md-block"
                                         t-esc="this.state.labels.email">
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                    <div t-ref="contacts_list" class="contacts_list mx-0 h-100"></div>
        </div>
        </div>
        </div>
    </t>
</templates>